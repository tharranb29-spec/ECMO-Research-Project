# PDB records are fixed-width 80-column records; their terminal spaces are data.
*.pdb whitespace=-trailing-space

# Preserve raw GNINA console output without treating its banner padding as an error.
track3_a2a/outputs/v1.4/docking/runs/**/*.log whitespace=-trailing-space

# AmberTools writes chemically meaningful fixed-format and padded records.
track3_a2a/outputs/v1.6/md/ligand_bundles/**/*.mol2 whitespace=-trailing-space
track3_a2a/outputs/v1.6/md/ligand_bundles/**/*.frcmod whitespace=-trailing-space
track3_a2a/outputs/v1.6/md/ligand_bundles/**/*.prmtop whitespace=-trailing-space
track3_a2a/outputs/v1.6/md/ligand_bundles/**/*.inpcrd whitespace=-trailing-space
track3_a2a/outputs/v1.6/md/ligand_bundles/**/*.log whitespace=-trailing-space
track3_a2a/outputs/v1.6/md/ligand_bundles/**/sqm.in whitespace=-trailing-space
track3_a2a/outputs/v1.6/md/ligand_bundles/**/sqm.out whitespace=-trailing-space

# Tier A tleap preflight outputs use the same Amber fixed-width formats.
track3_a2a/outputs/v1.6/md/tier_a_complex_preflight/**/*.prmtop whitespace=-trailing-space
track3_a2a/outputs/v1.6/md/tier_a_complex_preflight/**/*.inpcrd whitespace=-trailing-space
track3_a2a/outputs/v1.6/md/tier_a_complex_preflight/**/*.mol2 whitespace=-trailing-space
track3_a2a/outputs/v1.6/md/tier_a_complex_preflight/**/*.frcmod whitespace=-trailing-space
track3_a2a/outputs/v1.6/md/tier_a_complex_preflight/**/*.log whitespace=-trailing-space
