{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a2a-dashboard.discovery-run.v1",
  "title": "Track 3 shadow discovery run",
  "type": "object",
  "required": ["schema_version", "run_id", "workflow_state", "provider", "contract_inputs", "sources", "extractions", "molecules", "screen_eligible_queue", "human_disposition", "governance", "audit_log"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^shadow:"},
    "workflow_state": {"enum": ["live", "cached_demo"]},
    "provider": {"type": "object", "required": ["name", "requested_mode", "cached_fallback_allowed", "api_key_exposed"], "properties": {"requested_mode": {"enum": ["auto", "live", "demo"]}, "cached_fallback_allowed": {"type": "boolean"}, "api_key_exposed": {"const": false}}},
    "contract_inputs": {"type": "object"},
    "sources": {"type": "array"},
    "extractions": {"type": "array"},
    "molecules": {"type": "array", "maxItems": 12},
    "screen_eligible_queue": {"type": "object", "required": ["ordering", "records", "eligibility_contract", "claim_limit"], "properties": {"ordering": {"const": "unordered_composition_only"}, "eligibility_contract": {"type": "object", "required": ["schema_id", "contract_version", "decision_rule", "required_governed_inputs", "required_provenance_states", "firewalls"]}}},
    "human_disposition": {"type": "object"},
    "governance": {
      "type": "object",
      "required": ["autonomy_mode", "external_outcomes_loaded", "model_promotion_enabled", "tier_b_unlocked", "docking_role", "md_role", "md_required_for_review_queue", "md_required_for_dashboard_operation", "md_required_for_release"],
      "properties": {
        "autonomy_mode": {"const": "shadow_only"},
        "external_outcomes_loaded": {"const": false},
        "model_promotion_enabled": {"const": false},
        "tier_b_unlocked": {"const": false},
        "docking_role": {"const": "separate_structural_context_only"},
        "md_role": {"const": "optional_mechanistic_context_only"},
        "md_required_for_review_queue": {"const": false},
        "md_required_for_dashboard_operation": {"const": false},
        "md_required_for_release": {"const": false}
      }
    },
    "audit_log": {"type": "array", "minItems": 1}
  }
}
